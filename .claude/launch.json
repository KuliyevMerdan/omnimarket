{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "chain",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:chain"
      ],
      "port": 8545
    },
    {
      "name": "solana",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:solana"
      ],
      "port": 8899
    },
    {
      "name": "sui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:sui"
      ],
      "port": 9000
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@omnimarket/api",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@omnimarket/market-react",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-5174",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@omnimarket/market-react",
        "exec",
        "vite",
        "--port",
        "5174"
      ],
      "port": 5174
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@omnimarket/market-react",
        "exec",
        "vite",
        "preview",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174
    },
    {
      "name": "market-remote",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@omnimarket/market-react",
        "dev:remote"
      ],
      "port": 5181
    },
    {
      "name": "shell",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "OMNI_API_URL=http://localhost:8788",
        "pnpm",
        "--filter",
        "@omnimarket/shell-vue",
        "dev"
      ],
      "port": 5180
    },
    {
      "name": "api-shell",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=8788",
        "SIWE_ORIGIN=http://localhost:5180",
        "pnpm",
        "--filter",
        "@omnimarket/api",
        "dev"
      ],
      "port": 8788
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@omnimarket/ui",
        "storybook"
      ],
      "port": 6006
    },
    {
      "name": "shell-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@omnimarket/shell-vue",
        "exec",
        "vite",
        "preview",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "market-remote-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@omnimarket/market-react",
        "preview:remote"
      ],
      "port": 5181
    }
  ]
}
